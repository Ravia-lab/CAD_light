{
  "name": "ravia-cad-light",
  "private": true,
  "version": "1.44.0",
  "type": "module",
  "description": "RaVia CAD Light – ultraleichter 2D-Grundriss-Editor mit 3D-Realtime-View, Anlagenauslegung und BIM/TGA-Export",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:einzeldatei": "vite build --config vite.config.einzeldatei.ts",
    "paket": "node scripts/paket.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:pruefung": "tsc --noEmit -p tsconfig.pruefung.json",
    "verify": "tsc --noEmit -p tsconfig.pruefung.json && esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify.mjs --log-level=warning && node node_modules/.cache/verify.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "smoke:feat": "node scripts/smoke-features.mjs",
    "smoke:export": "node scripts/smoke-export.mjs",
    "smoke:round2": "node scripts/smoke-round2.mjs",
    "smoke:tga": "node scripts/smoke-tga.mjs",
    "smoke:griffe": "node scripts/smoke-griffe.mjs",
    "smoke:ebenen": "node scripts/smoke-ebenen.mjs",
    "smoke:embed": "node scripts/smoke-embed.mjs",
    "smoke:scan": "node scripts/smoke-raumscan.mjs",
    "smoke:ux": "node scripts/smoke-bedienung.mjs",
    "smoke:handwerker": "node scripts/smoke-handwerker.mjs",
    "smoke:tablet": "node scripts/smoke-tablet.mjs",
    "smoke:wp": "node scripts/smoke-waermepumpe.mjs",
    "smoke:raum": "node scripts/smoke-raum.mjs",
    "smoke:anlage": "node scripts/smoke-anlage.mjs",
    "smoke:druck": "node scripts/smoke-druck.mjs",
    "smoke:rohrnetz": "node scripts/smoke-rohrnetz.mjs",
    "smoke:schema": "node scripts/smoke-schema.mjs",
    "smoke:bild": "node scripts/smoke-bild.mjs",
    "smoke:spiegeln": "node scripts/smoke-spiegeln.mjs",
    "smoke:fbh3d": "node scripts/smoke-fbh3d.mjs",
    "smoke:tueren": "node scripts/smoke-tueren.mjs",
    "smoke:mappe": "node scripts/smoke-mappe.mjs",
    "smoke:einzeldatei": "node scripts/pruef-einzeldatei.mjs",
    "smoke:einzeldatei-scan": "node scripts/pruef-einzeldatei-scan.mjs",
    "handbuch:tafeln": "esbuild scripts/handbuch-symbole.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/handbuch-symbole.mjs --log-level=warning && node node_modules/.cache/handbuch-symbole.mjs",
    "handbuch": "npm run handbuch:tafeln && python3 handbuch/bauen.py",
    "handbuch:bilder": "node scripts/handbuch-bilder.mjs",
    "handbuch:abhilfen": "esbuild scripts/handbuch-abhilfen.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/handbuch-abhilfen.mjs --log-level=warning && node node_modules/.cache/handbuch-abhilfen.mjs",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=warning && node node_modules/.cache/bench.mjs",
    "reference:update": "esbuild scripts/update-reference.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/update-reference.mjs --log-level=warning && node node_modules/.cache/update-reference.mjs",
    "ifc": "tsx scripts/ifc-lesen.ts",
    "korpus:ifc": "esbuild scripts/ifc-korpus.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ifc-korpus.mjs --log-level=warning && node --max-old-space-size=6000 node_modules/.cache/ifc-korpus.mjs",
    "smoke:leisten": "node scripts/smoke-leisten.mjs",
    "sprache:bericht": "node scripts/sprachbericht.mjs",
    "smoke:sprache": "node scripts/smoke-sprache.mjs",
    "smoke:loeschen": "node scripts/smoke-loeschen.mjs",
    "smoke:ring": "node scripts/smoke-ring.mjs",
    "smoke:bestand": "node scripts/smoke-bestand.mjs",
    "smoke:geschosse": "node scripts/smoke-geschosse.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
