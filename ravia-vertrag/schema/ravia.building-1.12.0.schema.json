        },
        "curved": {
          "type": "boolean"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "azimuthDeg": {
          "type": "number",
          "description": "Nur Außenwände: Azimut der Außennormalen [°]"
        },
        "orientation": {
          "enum": [
            "N",
            "NO",
            "O",
            "SO",
            "S",
            "SW",
            "W",
            "NW"
          ]
        },
        "netArea": {
          "type": "number",
          "description": "Abzüglich Öffnungen [m²] (seit 1.9.0)"
        },
        "lengthUncertainty": {
          "type": "number"
        },
        "thicknessMeasured": {
          "type": "number"
        },
        "thicknessSpread": {
          "type": "number"
        },
        "profile": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Vec2"
          },
          "description": "Wandumriss bei nicht rechteckigen Wänden: x = Abstand ab start [m], y = Höhe über Fußboden [m] (seit 1.1.0)"
        },
        "kneeWall": {
          "type": "boolean"
        },
        "boundary": {
          "enum": [
            "exterior",
            "unheated",
            "neighbour",
            "ground",
            "interior"
          ],
          "description": "Was hinter der Wand liegt (seit 1.4.0, in 1.12.0 unverändert). Vorbelegt aus type (exterior→exterior, interior→interior), im Scan überschreibbar."
        },
        "boundarySource": {
          "enum": [
            "scan",
            "user"
          ]
        },
        "suspect": {
          "type": "boolean",
          "description": "Verdacht auf Scanfehler (seit 1.11.0)"
        },
        "shiftedBy": {
          "type": "number",
          "description": "Von Hand verschoben [m] (seit 1.11.0)"
        },
        "drawn": {
          "type": "boolean",
          "description": "Von Hand gezeichnet (seit 1.12.0)"
        },
        "confirmed": {
          "type": "boolean",
          "description": "Schräge Wand als echt bestätigt (seit 1.12.0)"
        }
      },
      "required": [
        "id",
        "levelId",
        "start",
        "end",
        "length",
        "height",
        "thickness",
        "thicknessSource",
        "type",
        "grossArea",
        "confidence",
        "curved",
        "sourceIds"
      ]
    },
    "Opening": {
