        },
        "type": {
          "enum": [
            "exterior",
            "interior"
          ]
        },
        "grossArea": {
          "type": "number",
          "description": "Aufmaß-Fläche Länge × Höhe bzw. Umrissfläche [m²]"
        },
        "confidence": {
